@using MudBlazor
@using Microsoft.AspNetCore.Components.Rendering

<MudPaper Class="pa-3 mb-4" Elevation="0">
    
    <!-- Layout para Desktop/Tablet -->
    <MudHidden Breakpoint="Breakpoint.SmAndDown" Invert="false">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Row="true" Spacing="2">
                <LikeButton IsLiked="IsLiked" Count="LikesCount" OnClick="HandleLikeClick" />
                <FavoriteButton IsFavorite="IsFavorite" Count="FavoritesCount" OnClick="HandleFavoriteClick" />
            </MudStack>
            
            <MudStack Row="true" Spacing="2">
                <WatchLaterButton IsInWatchLater="IsInWatchLater" OnClick="HandleWatchLaterClick" />
                <ViewsCounter Count="ViewsCount" />
            </MudStack>
        </MudStack>
    </MudHidden>

    <!-- Layout para Mobile -->
    <MudHidden Breakpoint="Breakpoint.MdAndUp" Invert="false">
        <MudStack Spacing="2">
            <!-- Primera fila: Like y Favorite -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <LikeButton IsLiked="IsLiked" Count="LikesCount" OnClick="HandleLikeClick" />
                <WatchLaterButton IsInWatchLater="IsInWatchLater" OnClick="HandleWatchLaterClick" />
            </MudStack>
            
            <!-- Segunda fila: Watch Later y Views -->
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <ViewsCounter Count="ViewsCount" />
                <FavoriteButton IsFavorite="IsFavorite" Count="FavoritesCount" OnClick="HandleFavoriteClick" />
            </MudStack>
        </MudStack>
    </MudHidden>

</MudPaper>

@code {
    [Parameter] public bool IsLiked { get; set; }
    [Parameter] public int LikesCount { get; set; }
    [Parameter] public bool IsFavorite { get; set; }
    [Parameter] public int FavoritesCount { get; set; }
    [Parameter] public bool IsInWatchLater { get; set; }
    [Parameter] public int ViewsCount { get; set; }
    
    [Parameter] public EventCallback<bool> OnLikeClick { get; set; }
    [Parameter] public EventCallback<bool> OnFavoriteClick { get; set; }
    [Parameter] public EventCallback<bool> OnWatchLaterClick { get; set; }
    
    private async Task HandleLikeClick()
    {
        await OnLikeClick.InvokeAsync(!IsLiked);
    }
    
    private async Task HandleFavoriteClick()
    {
        await OnFavoriteClick.InvokeAsync(!IsFavorite);
    }
    
    private async Task HandleWatchLaterClick()
    {
        await OnWatchLaterClick.InvokeAsync(!IsInWatchLater);
    }
}