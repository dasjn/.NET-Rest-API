<MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="4">
    @for (int i = 0; i < GetSkeletonCount(); i++)
    {
        <VideoCardSkeleton />
    }
</MudGrid>

@code {
    [CascadingParameter] private Breakpoint CurrentBreakpoint { get; set; }

    private int GetSkeletonCount()
    {
        return CurrentBreakpoint switch
        {
            Breakpoint.Xs => 3, 
            Breakpoint.Sm => 6,  
            _ => 12              
        };
    }
}
