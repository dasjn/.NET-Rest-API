@page "/video/{VideoId:long}"
@using IA.FrontEnd.Components
@using IA.FrontEnd.Models
@using IA.FrontEnd.Services
@inject VideoInteractionService InteractionService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ConfigurationSettings Config

<PageTitle>@(videoDetails?.Name ?? "Cargando video...")</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12" md="9">
        @if (isLoading)
        {
            <MudStack Spacing="2">
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Width="100%" Height="500px" />
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Text" Width="50%" Height="60px" />
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Text" Width="100%" Height="80px" />
            </MudStack>
        }
        else if (videoDetails != null)
        {
            <MudStack Spacing="3">
                <video controls style="width: 100%; border-radius: 8px;" autoplay
                       crossorigin="anonymous"
                       @key="@VideoId"
                       @onplaying="RegisterVideoView">
                    <source src="@GetVideoUrl(videoDetails.Uri)" type="video/mp4">
                    Your browser does not support the video tag.
                </video>

                <MudText Typo="Typo.h4">@videoDetails.Name</MudText>

                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <UserAvatar CustomImageUrl="@GetUploaderProfilePicture()" Size="40" />
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">
                        @(videoDetails.UploadedByUserName ?? "Usuario")
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Surface" Style="opacity: 0.6; margin-left: 16px;">
                        Publicado el @videoDetails.PublishDate.ToString("dd/MM/yyyy")
                    </MudText>
                </MudStack>

                <VideoInteractionButtons IsLiked="videoDetails.UserHasLiked"
                                         LikesCount="videoDetails.LikesCount"
                                         IsFavorite="videoDetails.UserHasFavorited"
                                         FavoritesCount="videoDetails.FavoritesCount"
                                         IsInWatchLater="videoDetails.UserHasWatchLater"
                                         ViewsCount="videoDetails.ViewsCount"
                                         OnLikeClick="HandleLikeClick"
                                         OnFavoriteClick="HandleFavoriteClick"
                                         OnWatchLaterClick="HandleWatchLaterClick" />

                @if (!string.IsNullOrEmpty(videoDetails.Description))
                {
                    <MudPaper Class="pa-4 mb-4" Elevation="1">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">Descripción</MudText>

                            <div class="description-container">
                                <MudText Typo="Typo.body1"
                                         Class="@GetDescriptionClass()"
                                         Style="white-space: pre-wrap; line-height: 1.5;">
                                    @videoDetails.Description
                                </MudText>

                                @if (ShouldShowToggleButton(videoDetails.Description))
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="ToggleDescription"
                                               Class="mt-2">
                                        @(isDescriptionExpanded ? "Mostrar menos" : "Mostrar más")
                                    </MudButton>
                                }
                            </div>
                        </MudStack>
                    </MudPaper>
                }

                <style>
                    .description-collapsed {
                        display: -webkit-box;
                        -webkit-line-clamp: 3;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                        text-overflow: ellipsis;
                    }

                    .description-expanded {
                        /* Mostrar todo el contenido */
                    }
                </style>

                <MudDivider />

                <MudText Typo="Typo.h6">
                    Comentarios (@videoDetails.CommentsCount)
                </MudText>

                <CommentForm VideoId="@VideoId"
                             ReplyToCommentId="@replyToCommentId"
                             ReplyToUserName="@replyToUserName"
                             OnCommentSubmit="HandleCommentSubmit"
                             OnCancelReply="CancelReply" />

                @if (isCommentsLoading)
                {
                    <MudStack Spacing="3">
                        @for (int i = 0; i < 3; i++)
                        {
                            <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="100px" />
                        }
                    </MudStack>
                }
                else if (!comments.Any())
                {
                    <MudAlert Severity="Severity.Info">No hay comentarios todavía. ¡Sé el primero en comentar!</MudAlert>
                }
                else
                {
                    <MudStack Spacing="3">
                        @foreach (var comment in comments.Where(c => c.ParentCommentId == null))
                        {
                            <CommentCard Comment="comment"
                                         OnReplyClick="HandleReplyClick"
                                         OnEditClick="HandleEditClick"
                                         OnDeleteClick="HandleDeleteClick"
                                         OnSaveEdit="HandleSaveEdit" />
                        }
                    </MudStack>
                }
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Error">El video no se encuentra disponible.</MudAlert>
        }
    </MudItem>

    <MudItem xs="12" md="3">
        <MudText Typo="Typo.h6" Class="mb-3">Videos recomendados</MudText>

        @if (isRelatedVideosLoading)
        {
            <MudStack Spacing="2">
                @for (int i = 0; i < 4; i++)
                {
                    <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Height="100px" />
                }
            </MudStack>
        }
        else if (relatedVideos?.Any() == true)
        {
            <MudStack Spacing="2">
                @foreach (var video in relatedVideos)
                {
                    <VideoCardHorizontal VideoId="@video.Id"
                                         Title="@video.Name"
                                         ChannelName="@video.UploadedByUserName"
                                         Views="@video.ViewsCount"
                                         ThumbnailUri="@video.ThumbnailUri"
                                         PublishedDate="@video.PublishDate" />
                }
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Info">No hay videos relacionados disponibles.</MudAlert>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public long VideoId { get; set; }

    private VideoDto? videoDetails;
    private List<CommentDto> comments = new();
    private List<VideoDto> relatedVideos = new();

    private bool isLoading = true;
    private bool isCommentsLoading = true;
    private bool isRelatedVideosLoading = true;
    private bool isDescriptionExpanded = false;

    private long _previousVideoId = 0;
    private long? replyToCommentId;
    private string? replyToUserName;

    protected override async Task OnInitializedAsync()
    {
        _previousVideoId = VideoId;
        await LoadAllData();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Solo recargar si el VideoId realmente ha cambiado
        if (VideoId > 0 && VideoId != _previousVideoId)
        {
            _previousVideoId = VideoId;

            // Resetear todos los estados inmediatamente
            ResetAllStates();

            // Forzar actualización de UI para mostrar los skeletons
            StateHasChanged();

            // Cargar nuevos datos
            await LoadAllData();
        }
    }

    private void ResetAllStates()
    {
        // Resetear estados de carga
        isLoading = true;
        isCommentsLoading = true;
        isRelatedVideosLoading = true;
        isDescriptionExpanded = false;

        // Limpiar datos anteriores
        videoDetails = null;
        comments.Clear();
        relatedVideos.Clear();

        // Resetear estado de UI de comentarios
        replyToCommentId = null;
        replyToUserName = null;
    }

    private async Task LoadAllData()
    {
        // Cargar datos en paralelo para mejor rendimiento
        var tasks = new List<Task>
        {
            LoadVideoDetails(),
            LoadComments(),
            LoadRelatedVideos()
        };

        await Task.WhenAll(tasks);
    }

    private async Task LoadVideoDetails()
    {
        isLoading = true;
        try
        {
            videoDetails = await InteractionService.GetVideoDetails(VideoId);

            if (videoDetails == null)
            {
                Snackbar.Add("El video no se pudo cargar", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar el video: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error loading video details: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadComments()
    {
        isCommentsLoading = true;
        try
        {
            comments = await InteractionService.GetVideoComments(VideoId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al cargar los comentarios: {ex.Message}", Severity.Error);
            Console.WriteLine($"Error loading comments: {ex}");
            comments = new List<CommentDto>(); // Asegurar que no sea null
        }
        finally
        {
            isCommentsLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadRelatedVideos()
    {
        isRelatedVideosLoading = true;
        try
        {
            var allVideos = await InteractionService.GetAllVideos();
            relatedVideos = allVideos?
                .Where(v => v.Id != VideoId)
                .OrderBy(x => Guid.NewGuid())
                .Take(8) // Reducir a 8 para mejor rendimiento
                .ToList() ?? new List<VideoDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading related videos: {ex}");
            relatedVideos = new List<VideoDto>(); // Silenciar errores, no es crítico
        }
        finally
        {
            isRelatedVideosLoading = false;
            StateHasChanged();
        }
    }

    private string GetVideoUrl(string uri)
    {
        if (string.IsNullOrEmpty(uri))
            return string.Empty;

        if (uri.StartsWith("http"))
            return uri;

        var normalizedPath = uri.Replace('\\', '/').TrimStart('/');
        return $"{Config.ApiBaseUrl}/{normalizedPath}";
    }

    private string? GetUploaderProfilePicture()
    {
        return videoDetails?.UploadedByUserProfilePictureUrl;
    }

    private string GetDescriptionClass()
    {
        return isDescriptionExpanded ? "description-expanded" : "description-collapsed";
    }

    private bool ShouldShowToggleButton(string description)
    {
        if (string.IsNullOrEmpty(description))
            return false;

        // Mostrar botón si la descripción tiene más de 200 caracteres o más de 3 líneas
        return description.Length > 200 || description.Split('\n').Length > 3;
    }

    private void ToggleDescription()
    {
        isDescriptionExpanded = !isDescriptionExpanded;
    }

    #region Comment Handlers

    private async Task HandleCommentSubmit((string content, long? parentCommentId) data)
    {
        try
        {
            var (content, parentId) = data;

            var result = await InteractionService.AddComment(VideoId, content, parentId);
            if (result != null)
            {
                // Actualizar comentarios
                await LoadComments();

                // Actualizar contador de comentarios
                if (videoDetails != null)
                {
                    videoDetails.CommentsCount++;
                }

                // Limpiar estado de respuesta
                replyToCommentId = null;
                replyToUserName = null;

                Snackbar.Add("Comentario publicado correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo publicar el comentario", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al publicar comentario: {ex.Message}", Severity.Error);
        }
    }

    private void HandleReplyClick(long commentId)
    {
        var comment = FindComment(commentId);
        if (comment != null)
        {
            replyToCommentId = commentId;
            replyToUserName = comment.UserName;
        }
    }

    private void HandleEditClick(long commentId)
    {
        // Esta lógica se maneja en el CommentCard
    }

    private async Task HandleSaveEdit((long commentId, string content) data)
    {
        var (commentId, content) = data;

        try
        {
            var success = await InteractionService.UpdateComment(VideoId, commentId, content);
            if (success)
            {
                await LoadComments();
                Snackbar.Add("Comentario actualizado correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo actualizar el comentario", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al actualizar comentario: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleDeleteClick(long commentId)
    {
        try
        {
            var success = await InteractionService.DeleteComment(VideoId, commentId);
            if (success)
            {
                await LoadComments();

                // Actualizar contador de comentarios
                if (videoDetails != null)
                {
                    // Restar 1 por el comentario principal, y también restar las respuestas si las había
                    var comment = FindComment(commentId);
                    int commentsToSubtract = 1; // El comentario principal
                    if (comment != null)
                    {
                        commentsToSubtract += comment.Replies.Count; // Más sus respuestas
                    }

                    videoDetails.CommentsCount = Math.Max(0, videoDetails.CommentsCount - commentsToSubtract);
                }

                Snackbar.Add("Comentario eliminado correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el comentario", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al eliminar comentario: {ex.Message}", Severity.Error);
        }
    }

    private void CancelReply()
    {
        replyToCommentId = null;
        replyToUserName = null;
    }

    private CommentDto? FindComment(long commentId)
    {
        // Primero buscar en comentarios principales
        var comment = comments.FirstOrDefault(c => c.Id == commentId);
        if (comment != null)
            return comment;

        // Si no se encuentra, buscar en respuestas
        foreach (var parentComment in comments)
        {
            var reply = parentComment.Replies.FirstOrDefault(r => r.Id == commentId);
            if (reply != null)
                return reply;
        }

        return null;
    }

    #endregion

    #region Video Interaction Handlers

    private async Task RegisterVideoView()
    {
        if (videoDetails == null || videoDetails.UserHasViewed)
            return;

        try
        {
            var success = await InteractionService.RegisterVideoView(VideoId);
            if (success)
            {
                // Actualizar estado local
                videoDetails.UserHasViewed = true;
                videoDetails.ViewsCount++;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            // Silenciar errores de vista, no crítico para la UX
            Console.WriteLine($"Error registering video view: {ex}");
        }
    }

    private async Task HandleLikeClick(bool shouldLike)
    {
        if (videoDetails == null) return;

        try
        {
            bool success;

            if (shouldLike)
            {
                success = await InteractionService.LikeVideo(VideoId);
                if (success)
                {
                    videoDetails.UserHasLiked = true;
                    videoDetails.LikesCount++;
                    Snackbar.Add("Video añadido a Me gusta", Severity.Success);
                }
            }
            else
            {
                success = await InteractionService.UnlikeVideo(VideoId);
                if (success)
                {
                    videoDetails.UserHasLiked = false;
                    videoDetails.LikesCount = Math.Max(0, videoDetails.LikesCount - 1);
                    Snackbar.Add("Video eliminado de Me gusta", Severity.Info);
                }
            }

            if (!success)
            {
                Snackbar.Add("No se pudo completar la acción", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleFavoriteClick(bool shouldFavorite)
    {
        if (videoDetails == null) return;

        try
        {
            bool success;

            if (shouldFavorite)
            {
                success = await InteractionService.AddToFavorites(VideoId);
                if (success)
                {
                    videoDetails.UserHasFavorited = true;
                    videoDetails.FavoritesCount++;
                    Snackbar.Add("Video añadido a Favoritos", Severity.Success);
                }
            }
            else
            {
                success = await InteractionService.RemoveFromFavorites(VideoId);
                if (success)
                {
                    videoDetails.UserHasFavorited = false;
                    videoDetails.FavoritesCount = Math.Max(0, videoDetails.FavoritesCount - 1);
                    Snackbar.Add("Video eliminado de Favoritos", Severity.Info);
                }
            }

            if (!success)
            {
                Snackbar.Add("No se pudo completar la acción", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleWatchLaterClick(bool shouldAddToWatchLater)
    {
        if (videoDetails == null) return;

        try
        {
            bool success;

            if (shouldAddToWatchLater)
            {
                success = await InteractionService.AddToWatchLater(VideoId);
                if (success)
                {
                    videoDetails.UserHasWatchLater = true;
                    Snackbar.Add("Video añadido a Ver más tarde", Severity.Success);
                }
            }
            else
            {
                success = await InteractionService.RemoveFromWatchLater(VideoId);
                if (success)
                {
                    videoDetails.UserHasWatchLater = false;
                    Snackbar.Add("Video eliminado de Ver más tarde", Severity.Info);
                }
            }

            if (!success)
            {
                Snackbar.Add("No se pudo completar la acción", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    #endregion
}