@page "/see-later"
@using IA.FrontEnd.Components
@using IA.FrontEnd.Models
@using IA.FrontEnd.Services
@using MudBlazor.Services
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject VideoInteractionService InteractionService
@inject ISnackbar Snackbar
@inject IBrowserViewportService BrowserViewportService

<PageTitle>Ver más tarde - Interventional Academy</PageTitle>

<MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
    <MudText Typo="Typo.h4">@GetPageTitle()</MudText>
    <MudSpacer />
    <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
        <SearchComponent @ref="searchComponent"
                         Context="watchlater"
                         OnSearch="HandleSearch"
                         Style="@(_currentBreakpoint <= Breakpoint.Sm ? "width: 100%" : "width: 100%; max-width: 300px;")" />
    </div>
</MudStack>

@if (!string.IsNullOrEmpty(_currentSearchQuery))
{
    <MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
        <MudAlert Severity="Severity.Info" Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
            Mostrando resultados para: "@_currentSearchQuery"
        </MudAlert>
        <MudSpacer />
        <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100 mt-2" : "")">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearSearch"
                       Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                Limpiar Búsqueda
            </MudButton>
        </div>
    </MudStack>
}

<InfiniteScrollContainer OnLoadMore="LoadMoreVideos"
                         IsLoading="_scrollService.IsLoading"
                         HasReachedEnd="_scrollService.HasReachedEnd">

    @if (_scrollService.Items.Count == 0 && !_scrollService.IsLoading)
    {
        <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Style="min-height: 60vh;">
            <MudItem xs="12" Class="text-center">
                @if (!string.IsNullOrEmpty(_currentSearchQuery))
                {
                    <MudStack Spacing="4" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">No se encontraron resultados para "@_currentSearchQuery" en tu lista de Ver más tarde</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Intenta con diferentes términos de búsqueda o agrega más videos a tu lista
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClearSearch">
                            Ver todos los videos de Ver más tarde
                        </MudButton>
                    </MudStack>
                }
                else
                {
                    <MudStack Spacing="4" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.WatchLater" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">No tienes videos guardados para ver más tarde</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            Agrega videos a esta lista para verlos cuando tengas tiempo disponible
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" StartIcon="@Icons.Material.Filled.VideoLibrary">
                            Explorar Videos
                        </MudButton>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    }
    else
    {
        <MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="4">
            @if (_initialLoading)
            {
                <VideoCardSkeletonWrapper />
            }
            else
            {
                @foreach (var video in _scrollService.Items)
                {
                    <VideoCard VideoId="video.Id"
                               Title="@video.Name"
                               ChannelName="@video.UploadedByUserName"
                               Views="@video.ViewsCount"
                               ThumbnailUri="@video.ThumbnailUri"
                               PublishedDate="@video.PublishDate" />
                }
            }
        </MudGrid>

        @if (_scrollService.Items.Count > 0 && string.IsNullOrEmpty(_currentSearchQuery))
        {
            <MudDivider Class="my-4" />

            <MudPaper Class="pa-4 mt-2" Elevation="0">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Gestionar lista "Ver más tarde"</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           OnClick="@(() => OpenClearConfirmationDialog())">
                    Vaciar lista
                </MudButton>
            </MudPaper>
        }
    }
</InfiniteScrollContainer>

@code {
    private readonly InfiniteScrollService<VideoDto> _scrollService = new();
    private SearchComponent? searchComponent;
    private string _currentSearchQuery = string.Empty;
    private bool _initialLoading = true;

    // Responsive variables
    private Breakpoint _breakpoint = Breakpoint.SmAndDown;
    private bool _row = true;
    private Breakpoint _currentBreakpoint = Breakpoint.Md;

    [Inject] private IDialogService DialogService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _scrollService.OnStateChanged += StateHasChanged;
        await LoadInitialData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task LoadInitialData()
    {
        _initialLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(_currentSearchQuery))
            {
                await _scrollService.LoadInitialData(LoadWatchLaterVideosPage);
            }
            else
            {
                await _scrollService.Search(_currentSearchQuery, SearchWatchLaterVideosPage);
            }
        }
        finally
        {
            _initialLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreVideos()
    {
        try
        {
            if (string.IsNullOrEmpty(_currentSearchQuery))
            {
                await _scrollService.LoadMoreData(LoadWatchLaterVideosPage);
            }
            else
            {
                await _scrollService.LoadMoreDataWithSearch(_currentSearchQuery, SearchWatchLaterVideosPage);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading more videos: {ex.Message}");
            Snackbar.Add("Error al cargar más videos", Severity.Warning);
        }
    }

    private async Task<List<VideoDto>> LoadWatchLaterVideosPage(int skip, int take)
    {
        return await InteractionService.GetWatchLaterVideosWithPagination(skip, take);
    }

    private async Task<List<VideoDto>> SearchWatchLaterVideosPage(string query, int skip, int take)
    {
        return await InteractionService.SearchVideosWithContext(query, "watchlater", skip, take);
    }

    private async Task HandleSearch(string query)
    {
        _currentSearchQuery = query;
        _initialLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(query))
            {
                await _scrollService.LoadInitialData(LoadWatchLaterVideosPage);
            }
            else
            {
                await _scrollService.Search(query, SearchWatchLaterVideosPage);
            }
        }
        finally
        {
            _initialLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearSearch()
    {
        _currentSearchQuery = string.Empty;
        searchComponent?.Clear();
        await HandleSearch(string.Empty);
    }

    private async Task OpenClearConfirmationDialog()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar acción",
            "¿Estás seguro que deseas vaciar tu lista de 'Ver más tarde'? Esta acción no se puede deshacer.",
            yesText: "Vaciar lista",
            cancelText: "Cancelar");

        if (result == true)
        {
            await ClearWatchLaterList();
        }
    }

    private async Task ClearWatchLaterList()
    {
        try
        {
            bool success = await InteractionService.ClearWatchLaterList();

            if (success)
            {
                _currentSearchQuery = string.Empty;
                searchComponent?.Clear();
                await LoadInitialData(); // Recargar datos como en LikedVideos
                Snackbar.Add("Lista 'Ver más tarde' vaciada correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo vaciar la lista", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string GetPageTitle()
    {
        if (!string.IsNullOrEmpty(_currentSearchQuery))
        {
            return $"Resultados para \"{_currentSearchQuery}\" en Ver más tarde";
        }
        return _scrollService.Items.Count > 0 ? "Ver más tarde" : "Ver más tarde";
    }

    // IBrowserViewportObserver implementation
    Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

    ResizeOptions IBrowserViewportObserver.ResizeOptions { get; } = new()
        {
            ReportRate = 250,
            NotifyOnBreakpointOnly = true
        };

    Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        _currentBreakpoint = args.Breakpoint;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _scrollService.OnStateChanged -= StateHasChanged;
        await BrowserViewportService.UnsubscribeAsync(this);
    }
}