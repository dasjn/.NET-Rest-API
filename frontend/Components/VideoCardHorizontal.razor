@using MudBlazor
@using System

<MudItem xs="12" sm="12" md="12" Style="overflow: hidden;" Class="pb-3">
    <MudLink Href="@($"/video/{Uri.EscapeDataString(VideoUri)}")">
        <MudCard Class="bg-transparent" Square Elevation="0" >
            <MudCardContent Class="p-0">
                <MudStack Spacing="3" Row="true" Style="height: 100%; width: 100%;">
                    <MudContainer class="align-items-center d-flex p-0" Style="flex: 0 0 40%;">
                        @* <video controls style="max-width: 100%; height: auto; border-radius: 10px;">
                            <source src="@VideoUri" type="video/mp4">
                            Your browser does not support the video tag.
                        </video> *@
                        <MudImage ObjectFit="ObjectFit.Cover" Src="https://picsum.photos/200/300"
                                   ObjectPosition="ObjectPosition.Center"
                                  Elevation="0"
                                  Class="rounded-2 w-100"
                                  Style="aspect-ratio: 16/9;" />

                    </MudContainer>

                    <MudStack Spacing="1" Style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
                        <MudText Typo="Typo.h6"
                                 Style="display: -webkit-box;
                                        -webkit-line-clamp: 1;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;
                                        text-overflow: ellipsis;"
                                 Title="@Name">
                            @Name
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Style="display: -webkit-box;
                                        -webkit-line-clamp: 2;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;
                                        text-overflow: ellipsis;"
                                 Title="@Description">
                            @Description
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudCardContent>
        </MudCard>
    </MudLink>
</MudItem>

@code {
    [Parameter] public string VideoUri { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
}
