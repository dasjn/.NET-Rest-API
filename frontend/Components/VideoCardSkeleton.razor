@using MudBlazor

<MudItem xs="12" sm="6" md="3">
    <MudCard>
        <MudCardContent>
            <MudStack Spacing="3">
                <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Width="100%" Height="200px" />
                <MudStack Spacing="1">
                    <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Width="25%" Height="30px" />
                    <MudSkeleton Animation="Animation.Wave" SkeletonType="SkeletonType.Rectangle" Width="100%" Height="50px" />
                </MudStack>
            </MudStack>
        </MudCardContent>
    </MudCard>
</MudItem>