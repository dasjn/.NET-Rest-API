@inherits LayoutComponentBase
@inject MainLayoutVM _mainLayoutVM

<MudThemeProvider Theme="@_mainLayoutVM.Theme" IsDarkMode="_mainLayoutVM.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudText Typo="Typo.h5" Class="ml-3">Interventional Academy</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center mud-height-full py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Botón de modo oscuro/claro
    private string DarkLightModeButtonIcon => _mainLayoutVM.IsDarkMode
        ? Icons.Material.Rounded.AutoMode
        : Icons.Material.Outlined.DarkMode;

    private void DarkModeToggle()
    {
        _mainLayoutVM.ToggleDarkMode();
    }
}