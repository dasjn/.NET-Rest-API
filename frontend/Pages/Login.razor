@page "/login"
@layout LoginLayout
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject MudBlazor.ISnackbar Snackbar

<MudCard Class="mt-4" Style="width: 100%; max-width: 500px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Align="Align.Center">Bienvenido a Interventional Academy</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText Align="Align.Center" Class="mb-4">Inicia sesión para acceder a la plataforma</MudText>

