@page "/history"
@using IA.FrontEnd.Components
@using IA.FrontEnd.Models
@using IA.FrontEnd.Services
@using MudBlazor.Services
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject VideoInteractionService InteractionService
@inject ISnackbar Snackbar
@inject IBrowserViewportService BrowserViewportService

<PageTitle>Historial - Interventional Academy</PageTitle>

<MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
    <MudText Typo="Typo.h4">Historial de visualización</MudText>
    <MudSpacer />
    <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "d-flex gap-2")">
        <SearchComponent @ref="searchComponent" Context="history" OnSearch="HandleSearch"
                         Style="@(_currentBreakpoint <= Breakpoint.Sm ? "width: 100%" : "width: 100%; max-width: 300px;")" />
        @if (!isLoading && videos != null && videos.Any())
        {
            <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "mt-2 w-100" : "")">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteSweep"
                           OnClick="@(() => OpenClearConfirmationDialog())"
                           Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                    Borrar historial
                </MudButton>
            </div>
        }
    </div>
</MudStack>

@if (isLoading)
{
    <VideoCardSkeletonWrapper />
}
else if (videos == null || !videos.Any())
{
    <MudItem xs="12">
        <MudPaper Class="pa-6" Elevation="3">
            <MudStack Spacing="4" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @(string.IsNullOrEmpty(currentSearchQuery)
                        ? "Tu historial está vacío"
                        : $"No se encontraron resultados para \"{currentSearchQuery}\" en tu historial")
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    @(string.IsNullOrEmpty(currentSearchQuery)
                        ? "Los videos que veas aparecerán aquí para que puedas retomar fácilmente tu aprendizaje"
                        : "Intenta con diferentes términos de búsqueda o explora más videos")
                </MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VideoLibrary">
                    Explorar Videos
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
}
else
{
    @if (!string.IsNullOrEmpty(currentSearchQuery))
    {
        <MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
            <MudAlert Severity="Severity.Info" Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                Mostrando resultados para: "@currentSearchQuery"
            </MudAlert>
            <MudSpacer />
            <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100 mt-2" : "")">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSearch"
                           Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                    Limpiar Búsqueda
                </MudButton>
            </div>
        </MudStack>
    }
    else
    {
        <MudPaper Class="pa-3 mb-3" Elevation="0">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Tu historial se almacena y puede ser eliminado en cualquier momento. Los videos aparecen ordenados por fecha de visualización, del más reciente al más antiguo.
            </MudText>
        </MudPaper>
    }

    <MudDivider />

    <MudStack Spacing="0" Class="mt-2">
        @foreach (var video in videos)
        {
            <MudPaper Class="pa-2" Elevation="0">
                <VideoCardHorizontal VideoId="video.Id"
                                     Title="@video.Name"
                                     ChannelName="@video.UploadedByUserName"
                                     Views="@video.ViewsCount"
                                     PublishedDate="@video.PublishDate.ToString("dd/MM/yyyy")"
                                     ThumbnailUri="@video.ThumbnailUri" />
            </MudPaper>
            <MudDivider />
        }
    </MudStack>
}

@code {
    private bool isLoading = true;
    private List<VideoDto>? videos;
    private string currentSearchQuery = string.Empty;
    private SearchComponent? searchComponent;

    // Nuevo para el responsive
    private Breakpoint _breakpoint = Breakpoint.SmAndDown;
    private bool _row = true;
    private Breakpoint _currentBreakpoint = Breakpoint.Md; // Valor predeterminado

    protected override async Task OnInitializedAsync()
    {
        await LoadHistoryVideos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // Implementaciones requeridas para IBrowserViewportObserver
    Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

    ResizeOptions IBrowserViewportObserver.ResizeOptions { get; } = new()
        {
            ReportRate = 250,
            NotifyOnBreakpointOnly = true
        };

    Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        _currentBreakpoint = args.Breakpoint;
        return InvokeAsync(StateHasChanged);
    }

    // Limpieza de recursos
    public async ValueTask DisposeAsync()
    {
        await BrowserViewportService.UnsubscribeAsync(this);
    }

    private async Task LoadHistoryVideos()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Si hay una búsqueda activa, usar la búsqueda contextual
            if (!string.IsNullOrWhiteSpace(currentSearchQuery))
            {
                videos = await InteractionService.SearchVideosWithContext(currentSearchQuery, "history");
            }
            else
            {
                // Si no hay búsqueda, cargar todo el historial
                videos = await InteractionService.GetViewedVideos();
            }
        }
        catch (Exception ex)
        {
            videos = new List<VideoDto>();
            Snackbar.Add($"Error al cargar el historial: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenClearConfirmationDialog()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar eliminación",
            "¿Estás seguro que deseas borrar todo tu historial de visualización? Esta acción no se puede deshacer.",
            yesText: "Borrar historial",
            cancelText: "Cancelar");

        if (result == true)
        {
            await ClearHistory();
        }
    }

    private async Task ClearHistory()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Crear método en el servicio para limpiar historial
            bool success = await InteractionService.ClearHistory();

            if (success)
            {
                currentSearchQuery = string.Empty; // Limpiar búsqueda activa
                                                   // Limpiar el campo de búsqueda
                if (searchComponent != null)
                {
                    searchComponent.Clear();
                }
                videos = new List<VideoDto>();
                Snackbar.Add("Historial eliminado correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo eliminar el historial", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string query)
    {
        currentSearchQuery = query;
        await LoadHistoryVideos();
    }

    private async Task ClearSearch()
    {
        currentSearchQuery = string.Empty;
        // Limpiar el campo de búsqueda
        if (searchComponent != null)
        {
            searchComponent.Clear();
        }
        await LoadHistoryVideos();
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;
}