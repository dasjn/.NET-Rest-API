@page "/"
@inject HttpClient Http
@using IA.FrontEnd.Components
@using IA.FrontEnd.Models
@using IA.FrontEnd.Services
@inject VideoInteractionService InteractionService

<PageTitle>Interventional Academy - Videos</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Videos destacados</MudText>

<MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="4">
    @if (isLoading)
    {
        <VideoCardSkeletonWrapper />
    }
    else if (videos == null || !videos.Any())
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info">No hay videos disponibles.</MudAlert>
        </MudItem>
    }
    else
    {
        @foreach (var video in videos)
        {
            <VideoCard VideoId="video.Id"
                       Title="@video.Name"
                       ChannelName="@video.UploadedByUserName"
                       Views="@video.ViewsCount"
                       PublishedDate="@video.PublishDate.ToString("dd/MM/yyyy")" />
        }
    }
</MudGrid>

@if (!isLoading && videos?.Any() == true)
{
    <MudDivider Class="my-6" />

    <MudText Typo="Typo.h4" Class="mb-4">Videos más vistos</MudText>

    <MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="4">
        @foreach (var video in videos.OrderByDescending(v => v.ViewsCount).Take(4))
        {
            <VideoCard VideoId="video.Id"
                       Title="@video.Name"
                       ChannelName="@video.UploadedByUserName"
                       Views="@video.ViewsCount"
                       PublishedDate="@video.PublishDate.ToString("dd/MM/yyyy")" />
        }
    </MudGrid>
}

@code {
    private bool isLoading = true;
    private List<VideoDto>? videos;

    protected override async Task OnInitializedAsync()
    {
        await LoadVideos();
    }

    private async Task LoadVideos()
    {
        try
        {
            var allVideos = await InteractionService.GetAllVideos();
            videos = allVideos;
        }
        catch (Exception ex)
        {
            // Manejar error
            videos = new List<VideoDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}