@page "/see-later"
@using IA.FrontEnd.Components
@using IA.FrontEnd.Models
@using IA.FrontEnd.Services
@using MudBlazor.Services
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@inject VideoInteractionService InteractionService
@inject ISnackbar Snackbar
@inject IBrowserViewportService BrowserViewportService

<PageTitle>Ver más tarde - Interventional Academy</PageTitle>

<MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
    <MudText Typo="Typo.h4">Ver más tarde</MudText>
    <MudSpacer />
    <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
        <SearchComponent @ref="searchComponent" Context="watchlater" OnSearch="HandleSearch"
                         Style="@(_currentBreakpoint <= Breakpoint.Sm ? "width: 100%" : "width: 100%; max-width: 300px;")" />
    </div>
</MudStack>

@if (isLoading)
{
    <VideoCardSkeletonWrapper />
}
else if (videos == null || !videos.Any())
{
    <MudItem xs="12">
        <MudPaper Class="pa-6" Elevation="3">
            <MudStack Spacing="4" AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Outlined.WatchLater" Size="Size.Large" />
                <MudText Typo="Typo.h6" Align="Align.Center">
                    @(string.IsNullOrEmpty(currentSearchQuery)
                        ? "No tienes videos guardados para ver más tarde"
                        : $"No se encontraron resultados para \"{currentSearchQuery}\" en tu lista de Ver más tarde")
                </MudText>
                <MudText Typo="Typo.body1" Align="Align.Center">
                    @(string.IsNullOrEmpty(currentSearchQuery)
                        ? "Agrega videos a esta lista para verlos cuando tengas tiempo disponible"
                        : "Intenta con diferentes términos de búsqueda o agrega más videos a tu lista")
                </MudText>
                <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VideoLibrary">
                    Explorar Videos
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>
}
else
{
    @if (!string.IsNullOrEmpty(currentSearchQuery))
    {
        <MudStack Row="@_row" Reverse="false" Breakpoint="@_breakpoint" Class="mb-4">
            <MudAlert Severity="Severity.Info" Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                Mostrando resultados para: "@currentSearchQuery"
            </MudAlert>
            <MudSpacer />
            <div class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100 mt-2" : "")">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSearch"
                           Class="@(_currentBreakpoint <= Breakpoint.Sm ? "w-100" : "")">
                    Limpiar Búsqueda
                </MudButton>
            </div>
        </MudStack>
    }

    <MudGrid Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Spacing="4">
        @foreach (var video in videos)
        {
            <VideoCard VideoId="video.Id"
                       Title="@video.Name"
                       ChannelName="@video.UploadedByUserName"
                       Views="@video.ViewsCount"
                       PublishedDate="@video.PublishDate.ToString("dd/MM/yyyy")"
                       ThumbnailUri="@video.ThumbnailUri" />
        }
    </MudGrid>

    <MudDivider Class="my-4" />

    <MudPaper Class="pa-4 mt-2" Elevation="0">
        <MudText Typo="Typo.subtitle1" Class="mb-2">Gestionar lista "Ver más tarde"</MudText>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.ClearAll"
                   OnClick="@(() => OpenClearConfirmationDialog())">
            Vaciar lista
        </MudButton>
    </MudPaper>
}

@code {
    private bool isLoading = true;
    private List<VideoDto>? videos;
    private string currentSearchQuery = string.Empty;
    private SearchComponent? searchComponent;

    // Nuevo para el responsive
    private Breakpoint _breakpoint = Breakpoint.SmAndDown;
    private bool _row = true;
    private Breakpoint _currentBreakpoint = Breakpoint.Md; // Valor predeterminado

    protected override async Task OnInitializedAsync()
    {
        await LoadWatchLaterVideos();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserViewportService.SubscribeAsync(this, fireImmediately: true);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    // Implementaciones requeridas para IBrowserViewportObserver
    Guid IBrowserViewportObserver.Id { get; } = Guid.NewGuid();

    ResizeOptions IBrowserViewportObserver.ResizeOptions { get; } = new()
        {
            ReportRate = 250,
            NotifyOnBreakpointOnly = true
        };

    Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        _currentBreakpoint = args.Breakpoint;
        return InvokeAsync(StateHasChanged);
    }

    // Limpieza de recursos
    public async ValueTask DisposeAsync()
    {
        await BrowserViewportService.UnsubscribeAsync(this);
    }

    private async Task LoadWatchLaterVideos()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Si hay una búsqueda activa, usar la búsqueda contextual
            if (!string.IsNullOrWhiteSpace(currentSearchQuery))
            {
                videos = await InteractionService.SearchVideosWithContext(currentSearchQuery, "watchlater");
            }
            else
            {
                // Si no hay búsqueda, cargar todos los videos de "ver más tarde"
                videos = await InteractionService.GetWatchLaterVideos();
            }
        }
        catch (Exception ex)
        {
            videos = new List<VideoDto>();
            Snackbar.Add($"Error al cargar los videos: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OpenClearConfirmationDialog()
    {
        bool? result = await DialogService.ShowMessageBox(
            "Confirmar acción",
            "¿Estás seguro que deseas vaciar tu lista de 'Ver más tarde'? Esta acción no se puede deshacer.",
            yesText: "Vaciar lista",
            cancelText: "Cancelar");

        if (result == true)
        {
            await ClearWatchLaterList();
        }
    }

    private async Task ClearWatchLaterList()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            bool success = await InteractionService.ClearWatchLaterList();

            if (success)
            {
                currentSearchQuery = string.Empty; // Limpiar búsqueda activa
                                                   // Limpiar el campo de búsqueda
                if (searchComponent != null)
                {
                    searchComponent.Clear();
                }
                videos = new List<VideoDto>();
                Snackbar.Add("Lista 'Ver más tarde' vaciada correctamente", Severity.Success);
            }
            else
            {
                Snackbar.Add("No se pudo vaciar la lista", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string query)
    {
        currentSearchQuery = query;
        await LoadWatchLaterVideos();
    }

    private async Task ClearSearch()
    {
        currentSearchQuery = string.Empty;
        // Limpiar el campo de búsqueda
        if (searchComponent != null)
        {
            searchComponent.Clear();
        }
        await LoadWatchLaterVideos();
    }

    [Inject] private IDialogService DialogService { get; set; } = default!;
}